# ==============================================================================
# IncuBrix Social Media Marketing & Content Engine
# Environment Configuration Template (.env.example)
#
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env and configure local parameters if needed.
# ==============================================================================

# Application Environment (development, test, production)
APP_ENV=development

# Generation Mode: OFFLINE_DETERMINISTIC (default, zero cost) | ONLINE_LLM
GENERATION_MODE=OFFLINE_DETERMINISTIC

# Campaign & Tracking Defaults
DEFAULT_CAMPAIGN_NAME=creator_repurpose_2026
DEFAULT_BASE_URL=https://app.incubrix.com/

# Optional LLM API Key (Only used if GENERATION_MODE=ONLINE_LLM)
# Left empty by default for secure offline execution
GEMINI_API_KEY=

# Local Rendering Paths
OUTPUT_DIR=output
LOGS_DIR=logs
LOG_LEVEL=INFO

